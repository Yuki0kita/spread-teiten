{
  "name": "spread-teiten",
  "version": "0.1.0",
  "private": true,
  "description": "スプレッド定点 - 国内暗号資産取引所のスプレッドを1分ごとに実測して記録する",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8660 --test-scheduled",
    "db:init": "wrangler d1 execute spread_teiten --local --file=./db/schema.sql",
    "db:init:remote": "wrangler d1 execute spread_teiten --remote --file=./db/schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.20.0"
  },
  "engines": {
    "node": ">=22"
  }
}
